# Copia este archivo como ".env" y llena los valores. NUNCA subas ".env" a internet ni a GitHub.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Dirección pública de tu tienda (en producción debe ser https://...)
BASE_URL=http://localhost:3000
STORE_NAME=Mi Tienda de Ropa
# WhatsApp con código de país y sin signos. Ejemplo Guatemala: 50212345678
WHATSAPP_NUMBER=
# Moneda de cobro (USD recomendado: es la que aceptan Stripe y PayPal en todos los países)
CURRENCY=USD

# Administrador inicial (solo se usa la primera vez). Si dejas la contraseña vacía se genera una aleatoria y se muestra en la consola.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Si usas un proxy inverso (Nginx, Cloudflare, etc.) pon 1
TRUST_PROXY=

# Tarjeta débito/crédito con Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (https://developer.paypal.com/dashboard/applications) ; PAYPAL_ENV = sandbox (pruebas) o live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
